# Flask
SECRET_KEY=replace-with-a-long-random-secret

# SQL Server (Windows Authentication). SQLite remains the fallback when omitted.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DTask+Management+System%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3B

# Optional AI provider. Without AI_API_KEY the app uses local mock mode.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# Optional SMTP. Without SMTP_HOST and SMTP_FROM the app uses mock email mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional default account overrides
ADMIN_PASSWORD=Admin@12345
USER_PASSWORD=User@12345
MANAGER_PASSWORD=Manager@12345
